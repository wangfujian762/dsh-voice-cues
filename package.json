{
  "name": "dsh-voice-cues",
  "version": "1.0.0",
  "description": "Short spoken cues when a turn finishes, an approval is requested, or the agent asks a question. macOS, Windows and Linux. · 回合结束、请求授权、提问时的语音提示音，默认东北话。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "notification",
    "sound",
    "voice",
    "alert",
    "accessibility"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "audio",
    "LICENSE",
    "client.js"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js && node --test"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangfujian762/dsh-voice-cues.git"
  },
  "homepage": "https://github.com/wangfujian762/dsh-voice-cues",
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
